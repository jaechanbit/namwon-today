# Web read-only client (actual values belong in .env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Collector CLI only. Never expose these through NEXT_PUBLIC_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Supabase CLI provisioning variables.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
